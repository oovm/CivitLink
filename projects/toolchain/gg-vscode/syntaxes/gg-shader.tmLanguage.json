{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GG Shader",
  "scopeName": "source.gg-compiler-shader",
  "patterns": [
    {
      "name": "comment.line.double-slash.gg-compiler-shader",
      "match": "//.*$",
      "captures": {
        "0": {
          "name": "comment.line.double-slash.gg-compiler-shader"
        }
      }
    },
    {
      "name": "comment.block.gg-compiler-shader",
      "begin": "/\*",
      "end": "\*/",
      "captures": {
        "0": {
          "name": "comment.block.gg-compiler-shader"
        }
      }
    },
    {
      "name": "keyword.control.gg-compiler-shader",
      "match": "\b(shader|vertex|fragment|uniform|varying|attribute|const|precision|highp|mediump|lowp|if|else|for|while|do|break|continue|return)\b",
      "captures": {
        "0": {
          "name": "keyword.control.gg-compiler-shader"
        }
      }
    },
    {
      "name": "constant.language.gg-compiler-shader",
      "match": "\b(true|false|PI|TAU|E)\b",
      "captures": {
        "0": {
          "name": "constant.language.gg-compiler-shader"
        }
      }
    },
    {
      "name": "string.quoted.single.gg-compiler-shader",
      "match": "'([^'\\]|\\.)*'",
      "captures": {
        "0": {
          "name": "string.quoted.single.gg-compiler-shader"
        }
      }
    },
    {
      "name": "string.quoted.double.gg-compiler-shader",
      "match": '"([^"\\]|\\.)*"',
      "captures": {
        "0": {
          "name": "string.quoted.double.gg-compiler-shader"
        }
      }
    },
    {
      "name": "constant.numeric.gg-compiler-shader",
      "match": "\b\d+(\.\d+)?\b",
      "captures": {
        "0": {
          "name": "constant.numeric.gg-compiler-shader"
        }
      }
    },
    {
      "name": "entity.name.function.gg-compiler-shader",
      "match": "\b\w+(?=\s*\()",
      "captures": {
        "0": {
          "name": "entity.name.function.gg-compiler-shader"
        }
      }
    },
    {
      "name": "entity.name.type.gg-compiler-shader",
      "match": "\b(vec2|vec3|vec4|mat2|mat3|mat4|float|int|bool|sampler2D|sampler3D|samplerCube)\b",
      "captures": {
        "0": {
          "name": "entity.name.type.gg-compiler-shader"
        }
      }
    },
    {
      "name": "punctuation.bracket.gg-compiler-shader",
      "match": "[\{\}\[\]()]",
      "captures": {
        "0": {
          "name": "punctuation.bracket.gg-compiler-shader"
        }
      }
    },
    {
      "name": "punctuation.separator.gg-compiler-shader",
      "match": ",",
      "captures": {
        "0": {
          "name": "punctuation.separator.gg-compiler-shader"
        }
      }
    },
    {
      "name": "punctuation.terminator.gg-compiler-shader",
      "match": ";",
      "captures": {
        "0": {
          "name": "punctuation.terminator.gg-compiler-shader"
        }
      }
    }
  ]
}
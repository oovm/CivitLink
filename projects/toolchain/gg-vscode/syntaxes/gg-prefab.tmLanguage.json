{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GG Prefab",
  "scopeName": "source.gg-prefab",
  "patterns": [
    {
      "name": "comment.line.double-slash.gg-prefab",
      "match": "//.*$",
      "captures": {
        "0": {
          "name": "comment.line.double-slash.gg-prefab"
        }
      }
    },
    {
      "name": "keyword.control.gg-prefab",
      "match": "\b(PrefabFile|Prefab|Entity|Component|Transform|TransformProperties|SpriteRenderer|SpriteRendererProperties|Camera|CameraProperties|Collider|ColliderProperties|Rigidbody|RigidbodyProperties|PlayerController|PlayerControllerProperties|EnemyAI|EnemyAIProperties|Weapon|WeaponProperties|UiCanvas|UiCanvasProperties|UiRectTransform|UiRectTransformProperties|UiImage|UiImageProperties|UiText|UiTextProperties|UiButton|UiButtonProperties|ColorBlock|UiMask|UiMaskProperties|UiLayout|UiLayoutProperties|UiScrollRect|UiScrollRectProperties|UiToggle|UiToggleProperties|UiSlider|UiSliderProperties|UiProgressBar|UiProgressBarProperties|UiRawImage|UiRawImageProperties|PrefabInstance|PrefabInstanceData|Dependency|Reference)\b",
      "captures": {
        "0": {
          "name": "keyword.control.gg-prefab"
        }
      }
    },
    {
      "name": "string.quoted.double.gg-prefab",
      "match": '"([^"\\]|\\.)*"',
      "captures": {
        "0": {
          "name": "string.quoted.double.gg-prefab"
        }
      }
    },
    {
      "name": "constant.numeric.gg-prefab",
      "match": "\b\d+(\.\d+)?\b",
      "captures": {
        "0": {
          "name": "constant.numeric.gg-prefab"
        }
      }
    },
    {
      "name": "constant.language.gg-prefab",
      "match": "\b(true|false|None|Some|box|sphere|capsule|ScreenSpace|WorldSpace|CameraSpace|Simple|Sliced|Tiled|Filled|Horizontal|Vertical|Radial90|Radial180|Radial360|Normal|Bold|Italic|BoldItalic|TopLeft|TopCenter|TopRight|MiddleLeft|MiddleCenter|MiddleRight|BottomLeft|BottomCenter|BottomRight|Wrap|Truncate|Overflow|None|ColorTint|SpriteSwap|Animation|Flexible|FixedColumnCount|FixedRowCount|Unrestricted|Elastic|Clamped|LeftToRight|RightToLeft|BottomToTop|TopToBottom|Direct|Smooth)\b",
      "captures": {
        "0": {
          "name": "constant.language.gg-prefab"
        }
      }
    },
    {
      "name": "entity.name.type.gg-prefab",
      "match": "\b(version|prefab|name|description|is_variant|base_prefab|entities|id|parent_id|components|type|properties|position|rotation|scale|sprite|sort_order|flip_x|flip_y|color|field_of_view|near_plane|far_plane|clear_color|orthographic|size|shape|size|offset|is_trigger|layer|mass|is_kinematic|use_gravity|linear_velocity|angular_velocity|speed|jump_force|health|damage|range|canvas_mode|sort_order|reference_resolution|match_mode|pixel_perfect|width|height|distance|event_camera|sorting_layer|sorting_order|anchor_min|anchor_max|offset_min|offset_max|pivot|size_delta|material|image_type|fill_method|fill_amount|preserve_aspect|text|font|font_size|font_style|alignment|overflow|line_spacing|interactable|transition|target_graphic|colors|normal_color|highlighted_color|pressed_color|disabled_color|fade_duration|on_click|show_mask_graphic|layout_type|padding|spacing|child_alignment|constraint|constraint_count|horizontal|vertical|movement_type|elasticity|scroll_sensitivity|content|viewport|is_on|group|on_value_changed|value|min_value|max_value|whole_numbers|direction|fill_rect|texture|uv_rect|variants|guid|prefabs|path|instances|scripts|enabled|dependencies|references|field|timestamp|hash)\b",
      "captures": {
        "0": {
          "name": "entity.name.type.gg-prefab"
        }
      }
    },
    {
      "name": "punctuation.bracket.gg-prefab",
      "match": "[\{\}\[\]()]",
      "captures": {
        "0": {
          "name": "punctuation.bracket.gg-prefab"
        }
      }
    },
    {
      "name": "punctuation.separator.gg-prefab",
      "match": ",",
      "captures": {
        "0": {
          "name": "punctuation.separator.gg-prefab"
        }
      }
    }
  ]
}
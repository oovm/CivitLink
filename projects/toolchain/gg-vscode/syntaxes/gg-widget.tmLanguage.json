{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GG Widget",
  "scopeName": "source.gg-compiler-widget",
  "patterns": [
    {
      "name": "comment.line.double-slash.gg-compiler-widget",
      "match": "//.*$",
      "captures": {
        "0": {
          "name": "comment.line.double-slash.gg-compiler-widget"
        }
      }
    },
    {
      "name": "keyword.control.gg-compiler-widget",
      "match": "\b(WidgetFile|Widget|Component|UiRectTransform|UiRectTransformProperties|UiImage|UiImageProperties|UiText|UiTextProperties|UiButton|UiButtonProperties|ColorBlock|UiMask|UiMaskProperties|UiLayout|UiLayoutProperties|UiScrollRect|UiScrollRectProperties|UiToggle|UiToggleProperties|UiSlider|UiSliderProperties|UiProgressBar|UiProgressBarProperties|UiRawImage|UiRawImageProperties)\b",
      "captures": {
        "0": {
          "name": "keyword.control.gg-compiler-widget"
        }
      }
    },
    {
      "name": "string.quoted.double.gg-compiler-widget",
      "match": '"([^"\\]|\\.)*"',
      "captures": {
        "0": {
          "name": "string.quoted.double.gg-compiler-widget"
        }
      }
    },
    {
      "name": "constant.numeric.gg-compiler-widget",
      "match": "\b\d+(\.\d+)?\b",
      "captures": {
        "0": {
          "name": "constant.numeric.gg-compiler-widget"
        }
      }
    },
    {
      "name": "constant.language.gg-compiler-widget",
      "match": "\b(true|false|None|Some|Simple|Sliced|Tiled|Filled|Horizontal|Vertical|Radial90|Radial180|Radial360|Normal|Bold|Italic|BoldItalic|TopLeft|TopCenter|TopRight|MiddleLeft|MiddleCenter|MiddleRight|BottomLeft|BottomCenter|BottomRight|Wrap|Truncate|Overflow|None|ColorTint|SpriteSwap|Animation|Flexible|FixedColumnCount|FixedRowCount|Unrestricted|Elastic|Clamped|LeftToRight|RightToLeft|BottomToTop|TopToBottom|Direct|Smooth)\b",
      "captures": {
        "0": {
          "name": "constant.language.gg-compiler-widget"
        }
      }
    },
    {
      "name": "entity.name.type.gg-compiler-widget",
      "match": "\b(version|widget|name|description|components|type|properties|width|height|anchor_min|anchor_max|offset_min|offset_max|pivot|size_delta|sprite|color|material|image_type|fill_method|fill_amount|preserve_aspect|text|font|font_size|font_style|alignment|overflow|line_spacing|interactable|transition|target_graphic|colors|normal_color|highlighted_color|pressed_color|disabled_color|fade_duration|on_click|show_mask_graphic|layout_type|padding|spacing|child_alignment|constraint|constraint_count|horizontal|vertical|movement_type|elasticity|scroll_sensitivity|content|viewport|is_on|group|on_value_changed|value|min_value|max_value|whole_numbers|direction|fill_rect|texture|uv_rect|dependencies|path|guid|references|field|timestamp|hash)\b",
      "captures": {
        "0": {
          "name": "entity.name.type.gg-compiler-widget"
        }
      }
    },
    {
      "name": "punctuation.bracket.gg-compiler-widget",
      "match": "[\{\}\[\]()]",
      "captures": {
        "0": {
          "name": "punctuation.bracket.gg-compiler-widget"
        }
      }
    },
    {
      "name": "punctuation.separator.gg-compiler-widget",
      "match": ",",
      "captures": {
        "0": {
          "name": "punctuation.separator.gg-compiler-widget"
        }
      }
    }
  ]
}
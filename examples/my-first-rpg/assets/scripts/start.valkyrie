# RPG 游戏脚本
# 使用 Valkyrie 脚本实现 RPG 游戏逻辑

using gg::engine;
using gg::ui;
using gg::audio;

# 游戏状态
let current_node = "start";
let variables = { affection_heroine: 0 };

# 对话节点处理函数
micro handle_node(node: String) {
    match (node) {
        case "start" => {
            # 加载场景
            engine.load_scene("rpg");
            
            # 设置背景
            ui.set_background("assets/backgrounds/bg_room.png");
            
            # 加载 BGM
            audio.play_bgm("assets/audio/bgm/morning.mp3", 0.8);
            
            current_node = "intro";
        },
        case "intro" => {
            ui.set_speaker("heroine");
            ui.show_message("早上好！睡得好吗？");
            ui.show_portrait("heroine", "smile", "center");
            ui.show_choices([
                { text: "早上好！", next: "good_morning" },
                { text: "...你是谁？", next: "who_are_you" }
            ]);
        },
        case "good_morning" => {
            ui.set_speaker("heroine");
            ui.show_message("嗯，早上好！今天天气真好呢，要不要一起去散步？");
            # 设置变量
            variables.affection_heroine = 10;
            current_node = "end";
        },
        case "who_are_you" => {
            ui.set_speaker("heroine");
            ui.show_message("哎？你不记得我了吗？我是你的青梅竹马啊...");
            ui.show_portrait("heroine", "sad", "center");
            current_node = "end";
        },
        case "end" => {
            ui.set_speaker("narrator");
            ui.show_message("故事才刚刚开始...（演示结束）");
        },
        case _ => {
            console.log("Unknown node: " + node);
        }
    }
}

# 处理选择
micro handle_choice(choice_index: Int) {
    if (current_node == "intro") {
        match (choice_index) {
            case 0 => current_node = "good_morning";
            case 1 => current_node = "who_are_you";
            case _ => console.log("Invalid choice index: " + choice_index);
        }
    }
}

# 游戏更新函数
micro update(delta_time: Float) {
    handle_node(current_node);
}

# 注册游戏循环
engine.set_update_fn(update);

# Galgame 游戏脚本
# 使用 Valkyrie 脚本实现对话系统

using gg::engine;
using gg::ui;
using gg::ecs;

# 初始化游戏
micro init_game() {
    # 创建 ECS 世界
    let world = ecs.create_world();
    
    # 添加游戏状态资源
    world.insert_resource("GameState", {
        current_node: "start",
        variables: {},
        is_dialogue_active: true
    });
    
    # 添加对话数据资源
    world.insert_resource("DialogueData", {
        nodes: {
            "start": {
                text: "这是一个晴朗的早晨...",
                speaker: "",
                portrait: null,
                expression: null,
                position: null,
                choices: [],
                next: "start_d1"
            },
            "start_d1": {
                text: "早上好！",
                speaker: "heroine",
                portrait: "heroine",
                expression: "smile",
                position: "center",
                choices: [],
                next: "start_d2"
            },
            "start_d2": {
                text: "你要怎么回应？",
                speaker: "",
                portrait: null,
                expression: null,
                position: null,
                choices: [
                    ["早上好！", "start_good"],
                    ["你是谁？", "start_who"]
                ],
                next: null
            },
            "start_good": {
                text: "嗯，早上好！",
                speaker: "heroine",
                portrait: "heroine",
                expression: "smile",
                position: "center",
                choices: [],
                next: "start_end"
            },
            "start_who": {
                text: "我是...你不记得我了吗？",
                speaker: "heroine",
                portrait: "heroine",
                expression: "confused",
                position: "center",
                choices: [],
                next: "start_end"
            },
            "start_end": {
                text: "故事才刚刚开始...",
                speaker: "",
                portrait: null,
                expression: null,
                position: null,
                choices: [],
                next: null
            }
        }
    });
    
    # 加载预制体
    let player_prefab = engine.load_prefab("assets/prefabs/player.prefab");
    let npc_prefab = engine.load_prefab("assets/prefabs/npc.prefab");
    
    # 实例化预制体
    let player = world.instantiate_prefab(player_prefab);
    let npc = world.instantiate_prefab(npc_prefab);
    
    # 设置 NPC 位置
    let npc_transform = npc.get_component("Transform");
    npc_transform.position = [200, 100, 0];
    
    # 创建对话实体
    let dialogue_entity = world.spawn();
    dialogue_entity.add_component("Dialogue", {
        text: "",
        speaker: "",
        portrait: null,
        expression: null,
        position: null
    });
    
    # 创建场景实体
    let scene_entity = world.spawn();
    scene_entity.add_component("Scene", {
        name: "default",
        background: "assets/graphics/backgrounds/default.png"
    });
    
    # 注册系统
    world.add_system("dialogue_system", dialogue_system);
    world.add_system("choice_system", choice_system);
    world.add_system("scene_system", scene_system);
    
    return world;
}

# 对话系统
micro dialogue_system(world) {
    let game_state = world.get_resource("GameState");
    let dialogue_data = world.get_resource("DialogueData");
    
    if (game_state.is_dialogue_active) {
        let current_node = game_state.current_node;
        let node_data = dialogue_data.nodes[current_node];
        
        # 更新对话组件
        let dialogue_query = world.query("Dialogue");
        for (entity, dialogue) in dialogue_query.iter() {
            dialogue.text = node_data.text;
            dialogue.speaker = node_data.speaker;
            dialogue.portrait = node_data.portrait;
            dialogue.expression = node_data.expression;
            dialogue.position = node_data.position;
            
            # 显示对话
            if (node_data.speaker != "") {
                ui.set_speaker(node_data.speaker);
            } else {
                ui.set_speaker("");
            }
            
            ui.show_message(node_data.text);
            
            if (node_data.portrait != null) {
                ui.show_portrait(node_data.portrait, node_data.expression, node_data.position);
            }
            
            # 显示选择项
            if (node_data.choices.length > 0) {
                let choices = [];
                for (choice in node_data.choices) {
                    choices.push({ text: choice[0], next: choice[1] });
                }
                ui.show_choices(choices);
            } else if (node_data.next != null) {
                # 自动前进到下一个节点
                game_state.current_node = node_data.next;
            } else {
                # 对话结束
                game_state.is_dialogue_active = false;
            }
        }
    }
}

# 选择系统
micro choice_system(world) {
    let game_state = world.get_resource("GameState");
    let dialogue_data = world.get_resource("DialogueData");
    
    # 处理选择输入
    # 这里应该与输入系统集成
}

# 场景系统
micro scene_system(world) {
    let scene_query = world.query("Scene");
    for (entity, scene) in scene_query.iter() {
        # 设置场景背景
        ui.set_background(scene.background);
    }
}

# 处理选择
micro handle_choice(choice_index: Int) {
    let world = engine.get_world();
    let game_state = world.get_resource("GameState");
    let dialogue_data = world.get_resource("DialogueData");
    
    let current_node = game_state.current_node;
    let node_data = dialogue_data.nodes[current_node];
    
    if (node_data.choices.length > 0 && choice_index < node_data.choices.length) {
        game_state.current_node = node_data.choices[choice_index][1];
    }
}

# 游戏更新函数
micro update(delta_time: Float) {
    let world = engine.get_world();
    world.run_systems();
}

# 初始化游戏
let world = init_game();
engine.set_world(world);
engine.set_update_fn(update);
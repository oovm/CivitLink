# STG 游戏脚本
# 使用 Valkyrie 脚本实现射击游戏逻辑

using gg::engine;
using gg::input;
using gg::graphics;
using gg::collision;
using gg::audio;

# 游戏状态
let game_state = {
    player: {
        x: 400,
        y: 500,
        width: 40,
        height: 40,
        speed: 5,
        fire_rate: 0.1,
        last_fire_time: 0,
        lives: 3,
        invulnerable: false,
        invulnerable_time: 0
    },
    enemies: [],
    player_bullets: [],
    enemy_bullets: [],
    score: 0,
    game_running: true,
    wave: 1,
    enemies_spawned: 0,
    enemies_alive: 0
};

# 敌人配置
let enemy_configs = [
    {
        type: "basic",
        width: 40,
        height: 40,
        speed: 2,
        health: 1,
        fire_rate: 1.0,
        bullet_speed: 3,
        score: 100
    },
    {
        type: "fast",
        width: 30,
        height: 30,
        speed: 4,
        health: 1,
        fire_rate: 0.8,
        bullet_speed: 4,
        score: 150
    },
    {
        type: "tank",
        width: 50,
        height: 50,
        speed: 1,
        health: 3,
        fire_rate: 1.2,
        bullet_speed: 2,
        score: 250
    }
];

# 初始化游戏
micro init_game() {
    # 设置背景
    graphics.set_background("assets/graphics/backgrounds/space.png");
    
    # 加载 BGM
    audio.play_bgm("assets/audio/bgm/battle.mp3", 0.8);
    
    # 创建玩家
    create_player();
}

# 创建玩家
micro create_player() {
    let player = engine.create_entity();
    player.set_name("player");
    player.add_component("Transform", {
        x: game_state.player.x,
        y: game_state.player.y,
        width: game_state.player.width,
        height: game_state.player.height
    });
    player.add_component("Sprite", {
        texture: "assets/graphics/sprites/player.png",
        flip_x: false,
        flip_y: false
    });
    player.add_component("Collider", {
        width: game_state.player.width,
        height: game_state.player.height,
        is_static: false
    });
}

# 生成敌人
micro spawn_enemies(delta_time) {
    # 每波敌人数量
    let enemies_per_wave = 10 + game_state.wave * 5;
    
    # 控制生成频率
    if (game_state.enemies_spawned < enemies_per_wave && Math.random() < 0.02) {
        let enemy_type = Math.floor(Math.random() * enemy_configs.length);
        let config = enemy_configs[enemy_type];
        
        let enemy = engine.create_entity();
        enemy.set_name("enemy_" + game_state.enemies_spawned);
        
        # 随机位置
        let x = Math.random() * (800 - config.width);
        let y = -config.height;
        
        enemy.add_component("Transform", {
            x: x,
            y: y,
            width: config.width,
            height: config.height
        });
        enemy.add_component("Sprite", {
            texture: "assets/graphics/sprites/enemy.png",
            flip_x: false,
            flip_y: false
        });
        enemy.add_component("Collider", {
            width: config.width,
            height: config.height,
            is_static: false
        });
        enemy.add_component("Enemy", {
            type: config.type,
            speed: config.speed,
            health: config.health,
            max_health: config.health,
            fire_rate: config.fire_rate,
            bullet_speed: config.bullet_speed,
            score: config.score,
            last_fire_time: 0
        });
        
        game_state.enemies.push(enemy);
        game_state.enemies_spawned += 1;
        game_state.enemies_alive += 1;
    }
    
    # 检查是否进入下一波
    if (game_state.enemies_alive == 0 && game_state.enemies_spawned >= enemies_per_wave) {
        game_state.wave += 1;
        game_state.enemies_spawned = 0;
        game_state.enemies_alive = 0;
        
        # 增加玩家生命值
        game_state.player.lives += 1;
        
        # 显示波次信息
        graphics.draw_text(`Wave ${game_state.wave}`, 350, 250, 30, Color::GREEN);
    }
}

# 处理输入
micro handle_input(delta_time) {
    let player = engine.get_entity("player");
    if (!player) return;
    
    let transform = player.get_component("Transform");
    
    # 移动玩家
    if (input.is_key_down("Left")) {
        transform.x = Math.max(0, transform.x - game_state.player.speed);
    } else if (input.is_key_down("Right")) {
        transform.x = Math.min(800 - game_state.player.width, transform.x + game_state.player.speed);
    }
    if (input.is_key_down("Up")) {
        transform.y = Math.max(0, transform.y - game_state.player.speed);
    } else if (input.is_key_down("Down")) {
        transform.y = Math.min(600 - game_state.player.height, transform.y + game_state.player.speed);
    }
    
    # 射击
    game_state.player.last_fire_time += delta_time;
    if (input.is_key_down("Space") && game_state.player.last_fire_time >= game_state.player.fire_rate) {
        fire_bullet(transform.x + game_state.player.width / 2 - 5, transform.y, -8, "player");
        game_state.player.last_fire_time = 0;
        
        # 播放射击音效
        audio.play_sfx("assets/audio/sfx/shot.mp3", 0.5);
    }
    
    # 特殊攻击
    if (input.is_key_pressed("Shift")) {
        special_attack();
    }
}

# 发射子弹
micro fire_bullet(x, y, speed, owner) {
    let bullet = engine.create_entity();
    bullet.set_name(owner + "_bullet_" + Date.now());
    
    bullet.add_component("Transform", {
        x: x,
        y: y,
        width: 10,
        height: 20
    });
    bullet.add_component("Sprite", {
        texture: "assets/graphics/sprites/bullet.png",
        flip_x: false,
        flip_y: owner == "enemy"
    });
    bullet.add_component("Collider", {
        width: 10,
        height: 20,
        is_static: false
    });
    bullet.add_component("Bullet", {
        speed: speed,
        owner: owner
    });
    
    if (owner == "player") {
        game_state.player_bullets.push(bullet);
    } else {
        game_state.enemy_bullets.push(bullet);
    }
}

# 特殊攻击
micro special_attack() {
    let player = engine.get_entity("player");
    if (!player) return;
    
    let transform = player.get_component("Transform");
    let center_x = transform.x + game_state.player.width / 2;
    
    # 发射散弹
    for (let i = -2; i <= 2; i++) {
        let angle = i * 0.2;
        let speed_x = Math.sin(angle) * 5;
        let speed_y = -Math.cos(angle) * 5;
        
        let bullet = engine.create_entity();
        bullet.set_name("special_bullet_" + Date.now() + "_" + i);
        
        bullet.add_component("Transform", {
            x: center_x - 5,
            y: transform.y
        });
        bullet.add_component("Sprite", {
            texture: "assets/graphics/sprites/bullet.png",
            flip_x: false,
            flip_y: false
        });
        bullet.add_component("Collider", {
            width: 10,
            height: 20,
            is_static: false
        });
        bullet.add_component("Bullet", {
            speed: { x: speed_x, y: speed_y },
            owner: "player",
            special: true
        });
        
        game_state.player_bullets.push(bullet);
    }
    
    # 播放特殊攻击音效
    audio.play_sfx("assets/audio/sfx/special.mp3", 0.5);
}

# 更新敌人
micro update_enemies(delta_time) {
    for (let i = game_state.enemies.length - 1; i >= 0; i--) {
        let enemy = game_state.enemies[i];
        if (!enemy) continue;
        
        let transform = enemy.get_component("Transform");
        let enemy_data = enemy.get_component("Enemy");
        
        # 移动敌人
        transform.y += enemy_data.speed;
        
        # 敌人射击
        enemy_data.last_fire_time += delta_time;
        if (enemy_data.last_fire_time >= enemy_data.fire_rate) {
            fire_bullet(transform.x + enemy_data.width / 2 - 5, transform.y + enemy_data.height, enemy_data.bullet_speed, "enemy");
            enemy_data.last_fire_time = 0;
        }
        
        # 检查敌人是否超出屏幕
        if (transform.y > 600) {
            engine.destroy_entity(enemy);
            game_state.enemies.splice(i, 1);
            game_state.enemies_alive -= 1;
        }
    }
}

# 更新子弹
micro update_bullets(delta_time) {
    # 更新玩家子弹
    for (let i = game_state.player_bullets.length - 1; i >= 0; i--) {
        let bullet = game_state.player_bullets[i];
        if (!bullet) continue;
        
        let transform = bullet.get_component("Transform");
        let bullet_data = bullet.get_component("Bullet");
        
        # 移动子弹
        if (typeof bullet_data.speed === "number") {
            transform.y += bullet_data.speed;
        } else {
            transform.x += bullet_data.speed.x;
            transform.y += bullet_data.speed.y;
        }
        
        # 检查子弹是否超出屏幕
        if (transform.y < -20 || transform.x < -20 || transform.x > 820) {
            engine.destroy_entity(bullet);
            game_state.player_bullets.splice(i, 1);
        }
    }
    
    # 更新敌人子弹
    for (let i = game_state.enemy_bullets.length - 1; i >= 0; i--) {
        let bullet = game_state.enemy_bullets[i];
        if (!bullet) continue;
        
        let transform = bullet.get_component("Transform");
        let bullet_data = bullet.get_component("Bullet");
        
        # 移动子弹
        transform.y += bullet_data.speed;
        
        # 检查子弹是否超出屏幕
        if (transform.y > 620) {
            engine.destroy_entity(bullet);
            game_state.enemy_bullets.splice(i, 1);
        }
    }
}

# 处理碰撞
micro handle_collision() {
    let player = engine.get_entity("player");
    if (!player) return;
    
    let player_transform = player.get_component("Transform");
    
    # 玩家与敌人碰撞
    for (let i = game_state.enemies.length - 1; i >= 0; i--) {
        let enemy = game_state.enemies[i];
        if (!enemy) continue;
        
        let enemy_transform = enemy.get_component("Transform");
        
        if (collision.check(
            player_transform.x, player_transform.y, game_state.player.width, game_state.player.height,
            enemy_transform.x, enemy_transform.y, enemy_transform.width, enemy_transform.height
        )) {
            if (!game_state.player.invulnerable) {
                take_damage();
            }
            
            # 销毁敌人
            engine.destroy_entity(enemy);
            game_state.enemies.splice(i, 1);
            game_state.enemies_alive -= 1;
        }
    }
    
    # 玩家与敌人子弹碰撞
    for (let i = game_state.enemy_bullets.length - 1; i >= 0; i--) {
        let bullet = game_state.enemy_bullets[i];
        if (!bullet) continue;
        
        let bullet_transform = bullet.get_component("Transform");
        
        if (collision.check(
            player_transform.x, player_transform.y, game_state.player.width, game_state.player.height,
            bullet_transform.x, bullet_transform.y, 10, 20
        )) {
            if (!game_state.player.invulnerable) {
                take_damage();
            }
            
            # 销毁子弹
            engine.destroy_entity(bullet);
            game_state.enemy_bullets.splice(i, 1);
        }
    }
    
    # 玩家子弹与敌人碰撞
    for (let i = game_state.player_bullets.length - 1; i >= 0; i--) {
        let bullet = game_state.player_bullets[i];
        if (!bullet) continue;
        
        let bullet_transform = bullet.get_component("Transform");
        
        for (let j = game_state.enemies.length - 1; j >= 0; j--) {
            let enemy = game_state.enemies[j];
            if (!enemy) continue;
            
            let enemy_transform = enemy.get_component("Transform");
            let enemy_data = enemy.get_component("Enemy");
            
            if (collision.check(
                bullet_transform.x, bullet_transform.y, 10, 20,
                enemy_transform.x, enemy_transform.y, enemy_transform.width, enemy_transform.height
            )) {
                # 减少敌人生命值
                enemy_data.health -= 1;
                
                # 检查敌人是否被消灭
                if (enemy_data.health <= 0) {
                    # 增加分数
                    game_state.score += enemy_data.score;
                    
                    # 销毁敌人
                    engine.destroy_entity(enemy);
                    game_state.enemies.splice(j, 1);
                    game_state.enemies_alive -= 1;
                    
                    # 播放爆炸音效
                    audio.play_sfx("assets/audio/sfx/explosion.mp3", 0.5);
                }
                
                # 销毁子弹
                engine.destroy_entity(bullet);
                game_state.player_bullets.splice(i, 1);
                break;
            }
        }
    }
}

# 受到伤害
micro take_damage() {
    game_state.player.lives -= 1;
    game_state.player.invulnerable = true;
    game_state.player.invulnerable_time = 2.0;
    
    # 播放受伤音效
    audio.play_sfx("assets/audio/sfx/hit.mp3", 0.5);
    
    # 检查游戏结束
    if (game_state.player.lives <= 0) {
        game_over();
    }
}

# 游戏结束
micro game_over() {
    game_state.game_running = false;
    
    # 显示游戏结束信息
    graphics.draw_text("Game Over", 350, 250, 30, Color::RED);
    graphics.draw_text(`Final Score: ${game_state.score}`, 350, 300, 20, Color::WHITE);
    graphics.draw_text("Press R to restart", 350, 350, 20, Color::WHITE);
    
    # 停止 BGM
    audio.stop_bgm();
    
    # 播放游戏结束音效
    audio.play_sfx("assets/audio/sfx/game_over.mp3", 0.5);
}

# 重置游戏
micro reset_game() {
    # 清除所有实体
    for (let enemy of game_state.enemies) {
        if (enemy) {
            engine.destroy_entity(enemy);
        }
    }
    
    for (let bullet of game_state.player_bullets) {
        if (bullet) {
            engine.destroy_entity(bullet);
        }
    }
    
    for (let bullet of game_state.enemy_bullets) {
        if (bullet) {
            engine.destroy_entity(bullet);
        }
    }
    
    # 重置游戏状态
    game_state = {
        player: {
            x: 400,
            y: 500,
            width: 40,
            height: 40,
            speed: 5,
            fire_rate: 0.1,
            last_fire_time: 0,
            lives: 3,
            invulnerable: false,
            invulnerable_time: 0
        },
        enemies: [],
        player_bullets: [],
        enemy_bullets: [],
        score: 0,
        game_running: true,
        wave: 1,
        enemies_spawned: 0,
        enemies_alive: 0
    };
    
    # 重新创建玩家
    create_player();
    
    # 重新加载 BGM
    audio.play_bgm("assets/audio/bgm/battle.mp3", 0.8);
}

# 游戏更新函数
micro update(delta_time: Float) {
    if (game_state.game_running) {
        # 处理输入
        handle_input(delta_time);
        
        # 生成敌人
        spawn_enemies(delta_time);
        
        # 更新敌人
        update_enemies(delta_time);
        
        # 更新子弹
        update_bullets(delta_time);
        
        # 处理碰撞
        handle_collision();
        
        # 更新无敌时间
        if (game_state.player.invulnerable) {
            game_state.player.invulnerable_time -= delta_time;
            if (game_state.player.invulnerable_time <= 0) {
                game_state.player.invulnerable = false;
            }
        }
    } else {
        # 检查是否重新开始
        if (input.is_key_pressed("R")) {
            reset_game();
        }
    }
}

# 渲染函数
micro render() {
    graphics.clear();
    
    # 显示分数和生命值
    graphics.draw_text(`Score: ${game_state.score}`, 10, 10, 20, Color::WHITE);
    graphics.draw_text(`Lives: ${game_state.player.lives}`, 10, 30, 20, Color::WHITE);
    graphics.draw_text(`Wave: ${game_state.wave}`, 10, 50, 20, Color::WHITE);
    
    # 显示玩家无敌状态
    if (game_state.player.invulnerable) {
        let player = engine.get_entity("player");
        if (player) {
            let transform = player.get_component("Transform");
            graphics.draw_rect(transform.x, transform.y, transform.width, transform.height, Color::rgba(255, 255, 255, 128));
        }
    }
}

# 初始化游戏
init_game();
engine.set_update_fn(update);
engine.set_render_fn(render);
# Player 脚本
# 处理玩家相关的游戏逻辑

using gg::ecs;
using gg::input;
using gg::engine;

# 玩家组件
component Player {
    name: String,
    health: i32,
    max_health: i32,
    position: [f32, f32],
    velocity: [f32, f32],
    move_speed: f32,
    fire_rate: f32,  # 射击间隔（秒）
    last_fire_time: f32,  # 上次射击时间
    events on_health_change: micro(current: i32, max: i32) -> (),
    events on_death: micro() -> (),
    events on_fire: micro() -> (),
    events on_hit: micro(damage: i32) -> ()
}

# 玩家系统
system PlayerSystem {
    micro execute(world: World, delta_time: f32): Result<()> {
        # 获取玩家实体
        let player_query: Query<Player> = world.query("Player");
        loop entity, player in player_query.iter() {
            # 处理输入
            player_controller.handle_input(player, delta_time);
            
            # 更新玩家位置
            player_controller.update_position(player);
            
            # 检查生命值
            player_controller.check_health(player);
        }
        
        return Ok()
    }
}

# 玩家控制器
class PlayerController {
    # 初始化玩家
    micro init_player(world: World, name: String, position: [f32, f32]): Player {
        let player_entity = world.spawn();
        let player = player_entity.add_component("Player", {
            name: name,
            health: 100,
            max_health: 100,
            position: position,
            velocity: [0.0, 0.0],
            move_speed: 5.0,
            fire_rate: 0.1,  # 每秒10发
            last_fire_time: 0.0
        });
        
        # 注册事件监听器
        player.on_health_change.subscribe(micro(current: i32, max: i32) {
            on_health_change_handler(player, current, max);
        });
        
        player.on_death.subscribe(micro() {
            on_death_handler(world, player);
        });
        
        player.on_fire.subscribe(micro() {
            on_fire_handler(player);
        });
        
        player.on_hit.subscribe(micro(damage: i32) {
            on_hit_handler(player, damage);
        });
        
        return player;
    }
    
    # 处理输入
    micro handle_input(player: Player, delta_time: f32) {
        # 处理移动
        let move_speed = player.move_speed;
        let velocity = [0.0, 0.0];
        
        if input.is_key_down("Left") {
            velocity[0] -= move_speed;
        }
        if input.is_key_down("Right") {
            velocity[0] += move_speed;
        }
        if input.is_key_down("Up") {
            velocity[1] -= move_speed;
        }
        if input.is_key_down("Down") {
            velocity[1] += move_speed;
        }
        
        # 应用移动
        player.position[0] += velocity[0] * delta_time * 60.0;
        player.position[1] += velocity[1] * delta_time * 60.0;
        
        # 处理射击
        if input.is_key_down("Space") {
            fire(player, delta_time);
        }
    }
    
    # 更新玩家位置
    micro update_position(player: Player) {
        # 边界检测
        if player.position[0] < 0.0 {
            player.position[0] = 0.0;
        } else if player.position[0] > 800.0 {
            player.position[0] = 800.0;
        }
        
        if player.position[1] < 0.0 {
            player.position[1] = 0.0;
        } else if player.position[1] > 600.0 {
            player.position[1] = 600.0;
        }
    }
    
    # 检查生命值
    micro check_health(player: Player) {
        if player.health <= 0 {
            player.health = 0;
            player.on_death();
        } else if player.health > player.max_health {
            player.health = player.max_health;
        }
    }
    
    # 射击
    micro fire(player: Player, delta_time: f32) {
        player.last_fire_time += delta_time;
        if player.last_fire_time >= player.fire_rate {
            player.last_fire_time = 0.0;
            player.on_fire();
            # 这里可以添加子弹生成逻辑
        }
    }
    
    # 受伤
    micro take_damage(player: Player, damage: i32) {
        player.health -= damage;
        player.on_hit(damage);
        player.on_health_change(player.health, player.max_health);
    }
    
    # 治疗
    micro heal(player: Player, amount: i32) {
        player.health += amount;
        if player.health > player.max_health {
            player.health = player.max_health;
        }
        player.on_health_change(player.health, player.max_health);
    }
    
    # 生命值变化处理
    micro on_health_change_handler(player: Player, current: i32, max: i32) {
        console::log(player.name + " health: " + current + "/" + max);
    }
    
    # 死亡处理
    micro on_death_handler(world: World, player: Player) {
        console::log(player.name + " has died!");
        # 可以在这里添加死亡的视觉效果、音效等
    }
    
    # 射击处理
    micro on_fire_handler(player: Player) {
        console::log(player.name + " fired!");
        # 可以在这里添加射击的视觉效果、音效等
    }
    
    # 被击中处理
    micro on_hit_handler(player: Player, damage: i32) {
        console::log(player.name + " hit for " + damage + " damage!");
        # 可以在这里添加被击中的视觉效果、音效等
    }
}

# 全局玩家控制器实例
let player_controller = PlayerController();
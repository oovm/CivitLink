// STG 游戏脚本
// 使用 Valkyrie 脚本实现射击游戏逻辑

@node start
[scene:stg]
[background:assets/backgrounds/bg_space.png]
[player:assets/sprites/player.png]
[enemy:assets/sprites/enemy.png]
[bullet:assets/sprites/bullet.png]
[bgm:assets/audio/bgm/battle.mp3,0.8]
-> game_loop

@node game_loop
[control:player,direction,move]
[control:player,space,shoot]
[control:player,shift,special]
[enemy:spawn,10,5]
[collision:player,enemy,game_over]
[collision:player,enemy_bullet,damage]
[collision:player_bullet,enemy,destroy]
-> game_loop

@node game_over
[speaker:narrator] 游戏结束！
-> start
<template>
    <Button class="accessible-button" style="padding-8-16" onClick={handleClick}>
        <Stack orientation="horizontal" style="gap-8 align-items-center">
            <Icon name={icon()} />
            <Text class="button-label">{label()}</Text>
        </Stack>
    </Button>
</template>

<script>
    using gg_editor::ui::widgets::{Button, Stack, Icon, Text};
    using gg_editor::ui::signal;

    let label = signal("Submit");
    let icon = signal("check");
    let aria_label = signal("Submit form");
    let aria_role = signal("button");

    let handleClick = micro() {
        console::log("Accessible button clicked: " + aria_label());
    };
</script>


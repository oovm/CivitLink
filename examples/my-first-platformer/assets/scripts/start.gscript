// Platformer 游戏脚本
// 使用 Valkyrie 脚本实现平台游戏逻辑

@node start
[scene:platformer]
[background:assets/backgrounds/bg_level1.png]
[player:assets/sprites/player.png]
[platform:assets/sprites/platform.png]
[collectible:assets/sprites/collectible.png]
-> game_loop

@node game_loop
[control:player,left/right,move]
[control:player,space,jump]
[physics:gravity,9.8]
[collision:player,platform]
[collision:player,collectible,collect]
-> game_loop
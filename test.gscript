@node start
[speaker:alice]
Hello, world!
[play_bgm:bgm1.mp3]
+ Choice 1 -> node1
+ Choice 2 -> node2 {variable > 5}
-> node1

@node node1
[speaker:bob]
Welcome to node 1!
[show_portrait:bob:smile:left]
-> node2

@node node2
[speaker:alice]
Welcome to node 2!
[hide_portrait:bob]
[change_background:bg2.png]
[set:variable=10]
[wait:2.0]
